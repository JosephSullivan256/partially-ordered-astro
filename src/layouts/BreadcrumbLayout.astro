---
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import Layout from './Layout.astro';

const { title, math = false, currentLabel, bodyclass, navclass="bg-paper", crumb_filter=((crumb)=>true) } = Astro.props;
---

<Layout {title} {math} {bodyclass}>
  <BreadcrumbNav slot="header" {currentLabel} {navclass} {crumb_filter} />
  <slot />
</Layout>
