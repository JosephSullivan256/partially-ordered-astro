---
import '../styles/global.css';

interface Props {
  title: string;
  home?: boolean;
  math?: boolean;
}

const { title, home = false, math = false, bodyclass="bg-paper-deep" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Partially Ordered — Joseph Sullivan’s mathematics blog and programming portfolio." />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>{title}</title>
    {math && <script is:inline define:vars={{}}>
      // Keep the notation used in mystyle.sty available for older converted
      // articles as well as any raw LaTeX Pandoc deliberately preserves.
      const macro = String.raw;
      window.MathJax = { tex: { tags: 'ams', inlineMath: [['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']], processEscapes: true, processEnvironments: true, packages: ['base', 'color', 'ams', 'physics'], macros: {
        bH: macro`\mathbb{H}`, bF: macro`\mathbb{F}`, bS: macro`\mathbb{S}`,
        cA: macro`\mathcal{A}`, cB: macro`\mathcal{B}`, cC: macro`\mathcal{C}`, cD: macro`\mathcal{D}`, cE: macro`\mathcal{E}`, cF: macro`\mathcal{F}`, cG: macro`\mathcal{G}`, cH: macro`\mathcal{H}`, cI: macro`\mathcal{I}`, cK: macro`\mathcal{K}`, cL: macro`\mathcal{L}`, cM: macro`\mathcal{M}`, cN: macro`\mathcal{N}`, cO: macro`\mathcal{O}`, cP: macro`\mathcal{P}`, cS: macro`\mathcal{S}`, cT: macro`\mathcal{T}`, cV: macro`\mathcal{V}`, cX: macro`\mathcal{X}`,
        A: macro`\mathbb{A}`, C: macro`\mathbb{C}`, N: macro`\mathbb{N}`, P: macro`\mathbb{P}`, Q: macro`\mathbb{Q}`, R: macro`\mathbb{R}`, Z: macro`\mathbb{Z}`,
        m: macro`\mathfrak{m}`, fm: macro`\mathfrak{m}`, eps: macro`\varepsilon`, tilde: macro`\widetilde`, defeq: macro`:=`, ds: macro`\displaystyle`, heart: macro`\heartsuit`, teq: macro`\trianglelefteq`, op: macro`\mathrm{op}`,
        id: macro`\mathrm{id}`, Hom: macro`\mathrm{Hom}`, Ob: macro`\mathrm{Ob}`, eval: macro`\mathrm{eval}`, Aut: macro`\mathrm{Aut}`, Quot: macro`\mathrm{Quot}`, Ext: macro`\mathrm{Ext}`, im: macro`\mathrm{im}`, coker: macro`\mathrm{coker}`, Spec: macro`\mathrm{Spec}`, Proj: macro`\mathrm{Proj}`, Coh: macro`\mathrm{Coh}`, End: macro`\mathrm{End}`, RHom: macro`\mathrm{RHom}`,
        GL: macro`\mathrm{GL}`, SL: macro`\mathrm{SL}`, QCoh: macro`\mathrm{QCoh}`, Set: macro`\mathrm{Set}`, Sch: macro`\mathrm{Sch}`, Sym: macro`\mathrm{Sym}`, Tor: macro`\mathrm{Tor}`, Rep: macro`\mathrm{Rep}`, rep: macro`\mathrm{rep}`, reg: macro`\mathrm{reg}`, colim: macro`\mathrm{colim}`,
        rmod: macro`\mathrm{mod}\text{-}`, rMod: macro`\mathrm{Mod}\text{-}`, lmod: macro`\text{-}\mathrm{mod}`, lMod: macro`\text{-}\mathrm{Mod}`, grlMod: [macro`\mathrm{Gr}\,#1\text{-}\mathrm{Mod}`, 1],
        cHom: macro`\mathcal{H}\mathit{om}`, cEnd: macro`\mathcal{E}\mathit{nd}`, Re: macro`\mathrm{Re}`, Im: macro`\mathrm{Im}`, codim: macro`\mathrm{codim}`, supp: macro`\mathrm{supp}`,
        floor: [macro`\left\lfloor #1 \right\rfloor`, 1], ceil: [macro`\left\lceil #1 \right\rceil`, 1], pdv: [macro`\frac{\partial #1}{\partial #2}`, 2], dv: [macro`\frac{\mathrm{d} #1}{\mathrm{d} #2}`, 2], dd: macro`\,\mathrm{d}`,
        '<': macro`\left\langle`, '>': macro`\right\rangle`
      } }, loader: { load: ['[tex]/color', '[tex]/ams', '[tex]/physics'] } };
    </script>}
    {math && <script src="/vendor/mathjax/tex-chtml-full.js" is:inline></script>}
  </head>
  <body class={bodyclass}>
    {!home && <slot name="header"><header class="border-b border-stone-300/80 bg-paper/90">
      <div class="content-width flex items-center justify-between px-6 py-4">
        <a href="/" class="no-underline"><img src="/logo.svg" width="140" height="35" alt="Partially Ordered" /></a>
        <nav class="flex items-center gap-4 text-sm" aria-label="Main navigation">
          <a href="/posts">Posts</a><a href="/projects">Projects</a><a href="/about">About</a>
        </nav>
      </div>
    </header></slot>}
    <main><slot /></main>
    <footer class="border-t border-stone-300 bg-paper-deep px-6 py-10 text-center text-sm text-stone-700">
      <p>© 2026 Joseph Sullivan · <a href="https://github.com/JosephSullivan256">GitHub</a> · <a href="mailto:partiallyordered@gmail.com">Email</a></p>
    </footer>
  </body>
</html>
