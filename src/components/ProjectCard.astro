---
import type { Project } from '../lib/projects';
const { project } = Astro.props as { project: Project };
const mainLink = project.href ?? project.external;
---

<article class="overflow-hidden rounded-xl w-72 border border-stone-300 bg-white shadow-sm">
  {mainLink ? <a href={mainLink}><img class="aspect-square w-full object-cover" src={project.image} alt={`${project.name} preview`} /></a> : <img class="aspect-square w-full object-cover" src={project.image} alt={`${project.name} preview`} />}
  <div class="p-6">
    <h3 class="font-serif text-2xl font-semibold text-stone-900">{project.name}</h3>
    <p class="mt-3 leading-7 text-stone-700">{project.description}</p>
    <div class="mt-5 flex gap-4 text-sm font-medium">
      {project.href && <a href={project.href}>View project →</a>}
      {project.external && <a href={project.external}>Play →</a>}
      {project.github && <a href={project.github}>GitHub</a>}
    </div>
  </div>
</article>
