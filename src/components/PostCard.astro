---
import type { Post } from '../lib/posts';
const { post } = Astro.props as { post: Post };
---

<article class="flex h-full flex-col rounded-xl border border-stone-300 bg-white p-6 shadow-sm">
  <p class="text-sm text-stone-500">{post.date}</p>
  <h3 class="mt-2 text-2xl font-semibold text-stone-900"><a class="text-inherit" href={`/posts/${post.slug}`}>{post.title}</a></h3>
  <p class="mt-3 grow leading-7 text-stone-700">{post.excerpt}</p>
  <div class="mt-5 flex flex-wrap gap-2">{post.tags.map((tag) => <span class="rounded-full bg-stone-200 px-3 py-1 text-xs text-stone-700">{tag}</span>)}</div>
  <a class="mt-5 font-medium" href={`/posts/${post.slug}`}>Read more →</a>
</article>
