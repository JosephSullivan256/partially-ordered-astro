---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../lib/projects';
---

<Layout title="Projects · Partially Ordered">
  <section class="content-width px-6 py-16">
    <p class="text-sm font-medium uppercase tracking-[.18em] text-accent">Programming</p>
    <h1 class="mt-3 font-serif text-5xl font-semibold text-stone-900 dark:text-stone-50">Projects</h1>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Layout>
