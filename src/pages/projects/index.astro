---
import Layout from '../../layouts/BreadcrumbLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../lib/projects';
---

<Layout title="projects · Partially Ordered">
  <section class="bg-paper w-full py-16"><div class="mx-auto px-6">
		<h2 class="section-title">Featured projects</h2>
		<div class="mx-auto mt-8 w-max grid gap-6 md:grid-cols-3">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	</div></section>
</Layout>
