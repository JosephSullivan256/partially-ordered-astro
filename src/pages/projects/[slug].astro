---
import Layout from '../../layouts/BreadcrumbLayout.astro';

const demos = {
  'marching-cubes': { title: 'Marching Cubes', script: '/projects/repos/WebGL-Marching-Cubes/bundle.js', stylesheet: '/projects/repos/WebGL-Marching-Cubes/style.css' },
  particles: { title: 'Particles', script: '/projects/repos/WebGL-Particles/bundle.js', stylesheet: '/projects/repos/WebGL-Particles/style.css' },
  deduction: { title: 'Deduction', script: '/projects/repos/Deduction/dist/bundle.js' },
};

export function getStaticPaths() {
  const staticDemos = {
    'marching-cubes': { title: 'Marching Cubes', script: '/projects/repos/WebGL-Marching-Cubes/bundle.js', stylesheet: '/projects/repos/WebGL-Marching-Cubes/style.css' },
    particles: { title: 'Particles', script: '/projects/repos/WebGL-Particles/bundle.js', stylesheet: '/projects/repos/WebGL-Particles/style.css' },
    deduction: { title: 'Deduction', script: '/projects/repos/Deduction/dist/bundle.js' },
  };
  return Object.entries(staticDemos).map(([slug, demo]) => ({ params: { slug }, props: { demo } }));
}

const { demo } = Astro.props;
---

<Layout title={`${demo.title} · Partially Ordered`} currentLabel={demo.title} bodyclass="bg-paper">
  {demo.stylesheet && <link rel="stylesheet" href={demo.stylesheet} />}
  <section class="content-width px-6 py-12">
    <p class="text-sm"><a href="/projects">← All projects</a></p>
    <h1 class="mt-4 font-serif text-4xl font-semibold text-stone-900">{demo.title}</h1>
    {demo.title !== 'Deduction' ? <div class="mt-8 overflow-auto rounded-lg border border-stone-300 bg-white p-2"><canvas id="canvas" width="480" height="480"></canvas></div> : <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]"><div class="min-h-[30rem] rounded-lg border border-stone-300 bg-white p-2"><canvas id="canvas"></canvas><div class="mt-3 flex gap-3"><input id="undo" type="button" value="Undo" class="rounded bg-accent px-4 py-2 text-white" /><input id="redo" type="button" value="Redo" class="rounded bg-accent px-4 py-2 text-white" /></div></div><div class="space-y-3">{[['assumption', '(A)'], ['introduce and', '(∧I)'], ['eliminate and', '(∧E)'], ['introduce implies', '(→I)'], ['eliminate implies', '(→E)'], ['introduce not', '(¬I)'], ['eliminate not', '(¬E)'], ['raa', '(RAA)'], ['introduce or', '(∨I)'], ['eliminate or', '(∨E)']].map(([id, label]) => <div id={id} class="flex flex-wrap gap-2"><input type="text" autocomplete="off" spellcheck="false" class="deduction-textbox min-w-48 grow rounded border border-stone-400 bg-white px-3 py-2 text-stone-900" placeholder="Conclusion" /><input type="button" value={label} class="deduction-button rounded bg-accent px-3 py-2 text-white" /><span class="deduction-suggestions flex gap-2"></span></div>)}</div></div>}
  </section>
  <script src={demo.script} is:inline></script>
</Layout>
