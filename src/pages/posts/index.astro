---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../lib/posts';
---

<Layout title="Posts · Partially Ordered">
  <section class="content-width px-6 py-16">
    <p class="text-sm font-medium uppercase tracking-[.18em] text-accent">Writing</p>
    <h1 class="mt-3 font-serif text-5xl font-semibold text-stone-900 dark:text-stone-50">Posts</h1>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Layout>
