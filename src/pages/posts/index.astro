---
import Layout from '../../layouts/BreadcrumbLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../lib/posts';
---

<Layout title="posts · Partially Ordered">
  <section class="bg-paper w-full px-6 py-16">
    <div class="mx-auto max-w-128 flex flex-col gap-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Layout>
