---
import Layout from '../../layouts/Layout.astro';
import { articleHtml, posts } from '../../lib/posts';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const html = articleHtml(post.slug);
---

<Layout title={`${post.title} · Partially Ordered`} math>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <p class="mb-7 text-sm"><a href="/posts">← All posts</a></p>
    <div class="article-content" set:html={html} />
  </article>
</Layout>
