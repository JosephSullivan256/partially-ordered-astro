---
import Layout from '../../layouts/BreadcrumbLayout.astro';
import { articleHtml, posts } from '../../lib/posts';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const html = articleHtml(post.slug);
---

<Layout title={`${post.title} · Partially Ordered`} math currentLabel={post.title.toLowerCase()} bodyclass="bg-paper">
  <article class="mx-auto max-w-3xl px-6 py-16">
    <div class="article-content" set:html={html} />
  </article>
</Layout>
